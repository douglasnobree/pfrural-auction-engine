NODE_ENV=development
PORT=4100
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://auction_engine:change_this_postgres_password@localhost:5433/auction_engine
DATABASE_POOL_MAX=20

RABBITMQ_URL=amqp://auction_engine:change_this_rabbitmq_password@localhost:5672

REDIS_URL=redis://localhost:6379

AUTH_MODE=mock
INTERNAL_SERVICE_TOKEN=local-development-token
WS_TICKET_TTL_SECONDS=60
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
RATE_LIMIT_PER_MINUTE=30
SANDBOX_ENABLED=true

POSTGRES_DB=auction_engine
POSTGRES_USER=auction_engine
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_PORT=5433

RABBITMQ_USER=auction_engine
RABBITMQ_PASSWORD=change_this_rabbitmq_password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379
